{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloud-ci-rank",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-25",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloud-ci-rank",
      "database_id": "f7d6e5f8-ce82-4aac-acdc-a12317abaa29",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "cloud-ci-rank-preview",
        "database_id": "ed913b54-9147-4a80-a04f-aa372c4811db"
      }
    ]
  }
}
